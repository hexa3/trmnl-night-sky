{% if meta %}
<div class="layout layout--row layout--left gap--small">
  {% render "sky_chart", chart: chart, px: 186, sizes: "5,4,3,2,0,0", tags: "none", compass: false %}
  <div class="ns-col ns-grow gap--small">
    <span class="value value--large value--tnums ns-score">{{ score.value }}<span class="value value--xsmall">/10</span></span>
    <span class="title title--small">{{ score.verdict }}</span>
    {% render "moon_icon", moon: moon, size: 30 %}
    <span class="description">{{ moon.illum }}% moon</span>
    <span class="description">{{ visible_count }} planet{% if visible_count != 1 %}s{% endif %}</span>
  </div>
</div>
{% endif %}

<div class="title_bar">
  <span class="title">Night Sky</span>
</div>
